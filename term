#!/bin/sh
# Browser terminal for this machine: ttyd on localhost with every session under termbridge.
#   term              run it (the login service does this)
#   term help         show this
#   term url          print the address to bookmark; add ?arg=ssh&arg=<host> for a tab that opens on <host>
#   term sessions     list the shells kept for tabs, with a link that reopens each in a new tab
#   term kill <id>    end one of them
#   term prune        end every session detached for 24 hours or more
# ttyd only answers under a random secret path, so other web pages can't guess their way to a shell.
set -e
dir=$(dirname "$(readlink -f "$0")")
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
# login services start without a locale, and programs then count UTF-8 bytes as characters
export LANG="${LANG:-en_US.UTF-8}"
port=${TERM_PORT:-7681}
secret_file="$HOME/.config/term/secret"
if [ ! -s "$secret_file" ]; then
  mkdir -p "$(dirname "$secret_file")"
  (umask 077 && python3 -c 'import secrets; print(secrets.token_urlsafe(18))' > "$secret_file")
fi
secret=$(cat "$secret_file")
url="http://localhost:$port/$secret/"
case $1 in
help|-h|--help)
  sed -n '2,/^set -e/p' "$0" | sed '$d; s/^# \{0,1\}//'
  exit ;;
'') ;;
url)
  echo "$url"
  exit ;;
sessions|kill|prune)
  exec python3 - "$url" "$@" <<'EOF'
import json, os, signal, subprocess, sys, time
url, cmd, *rest = sys.argv[1:]
d = os.path.expanduser("~/.cache/term/sessions")
def ago(t):
    s = int(time.time() - t)
    return next(f"{s // n}{u} ago" for n, u in ((86400, "d"), (3600, "h"), (60, "m"), (1, "s")) if s >= n or n == 1)
def ps(fmt, pid):
    r = subprocess.run(["ps", "-o", fmt + "=", "-p", str(pid)], capture_output=True, text=True)
    return r.stdout.strip()
def cwd(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        r = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"], capture_output=True, text=True)
        return next((l[1:] for l in r.stdout.splitlines() if l.startswith("n")), "?")
sessions = []
for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
    if not f.endswith(".json"):
        continue
    try:
        m = json.load(open(os.path.join(d, f)))
        os.kill(m["pid"], 0)
    except (OSError, ValueError, KeyError):
        continue
    sessions.append((f[:-5], m))
if cmd == "kill":
    ids = [i for i, _ in sessions if rest and i.startswith(rest[0])]
    if len(ids) != 1:
        sys.exit(f"term kill: {'no' if not ids else 'more than one'} session matches {rest[:1]}")
    os.kill(dict(sessions)[ids[0]]["pid"], signal.SIGHUP)
    sys.exit(f"ended {ids[0]}")
if cmd == "prune":
    stale = [(i, m) for i, m in sessions if not m["attached"] and time.time() - m["detached"] >= 86400]
    for i, m in stale:
        os.kill(m["pid"], signal.SIGHUP)
        print(f"ended {i}  detached {ago(m['detached'])}")
    if not stale:
        print("no sessions detached 24h+")
    sys.exit()
here = os.environ.get("TERMBRIDGE_TAB")
known = {i for i, _ in sessions}
older = [f[:-5] for f in sorted(os.listdir(d)) if f.endswith(".sock") and f[:-5] not in known] if os.path.isdir(d) else []
if not sessions and not older:
    print("no sessions")
for i, m in sessions:
    fg = int(ps("tpgid", m["pid"]) or m["pid"])
    fg = fg if fg > 0 else m["pid"]
    state = "this tab" if i == here else "attached" if m["attached"] else "detached " + ago(m["detached"])
    print(f"{i}  {state:<16} started {ago(m['started']):<8}  {ps('command', fg)[:60]}")
    print(f"    {cwd(fg)}")
    print(f"    {url}?attach={i}")
for i in older:
    print(f"{i}  (started by an older termbridge, no details)")
    print(f"    {url}?attach={i}")
EOF
  ;;
*)
  echo "term: unknown command '$1'" >&2
  sed -n '2,/^set -e/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2
  exit 1 ;;
esac
case $(uname) in Darwin) lo=lo0 ;; *) lo=lo ;; esac

# ttyd's own page plus term-tab.js (each tab keeps its shell across reconnects), term-page.js (theme, key mappings, bell), the tab icon and the Nerd Font icons as
# a web font (Brave hides locally installed fonts from pages), scaled to one Menlo cell as iTerm2 draws
# them; rebuilt only when
# ttyd or those files change, by fetching the page from a throwaway ttyd on a unix socket
page="$HOME/.cache/term/index.html"
python3 - "$page" "$dir" "$(command -v ttyd)" <<'EOF'
import base64, os, re, shutil, socket, subprocess, sys, tempfile, time
page, d, ttyd = sys.argv[1:]
srcs = [ttyd] + [os.path.join(d, f) for f in ("term", "term-tab.js", "term-page.js", "term-icon.png", "term-symbols.ttf")]
if os.path.exists(page) and os.path.getmtime(page) >= max(map(os.path.getmtime, srcs)):
    sys.exit()
tmp = tempfile.mkdtemp()
sock = os.path.join(tmp, "ttyd.sock")
p = subprocess.Popen([ttyd, "-i", sock, "true"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
try:
    for _ in range(100):
        if os.path.exists(sock):
            break
        time.sleep(0.05)
    c = socket.socket(socket.AF_UNIX)
    c.connect(sock)
    c.sendall(b"GET / HTTP/1.0\r\nHost: localhost\r\n\r\n")
    resp = b""
    while chunk := c.recv(1 << 16):
        resp += chunk
finally:
    p.terminate()
    shutil.rmtree(tmp)
html = resp.split(b"\r\n\r\n", 1)[1].decode()
icon = base64.b64encode(open(os.path.join(d, "term-icon.png"), "rb").read()).decode()
html = re.sub(r'<link rel="icon"[^>]*>', lambda _: f'<link rel="icon" type="image/png" href="data:image/png;base64,{icon}">', html, count=1)
html = re.sub(r"<title>[^<]*</title>", lambda _: f"<title>{socket.gethostname().split('.')[0]}</title>", html, count=1)
font = base64.b64encode(open(os.path.join(d, "term-symbols.ttf"), "rb").read()).decode()
i = html.index("</head>")
html = html[:i] + f'<style>@font-face{{font-family:"TermSymbols";src:url(data:font/ttf;base64,{font}) format("truetype");size-adjust:60%}}</style>' + html[i:]
html = html.replace("<head>", "<head><script>" + open(os.path.join(d, "term-tab.js")).read() + "</script>", 1)
i = html.rindex("</body>")
html = html[:i] + "<script>" + open(os.path.join(d, "term-page.js")).read() + "</script>" + html[i:]
os.makedirs(os.path.dirname(page), exist_ok=True)
with open(page + ".tmp", "w") as f:
    f.write(html)
os.replace(page + ".tmp", page)
EOF

cd "$HOME"
exec ttyd -i "$lo" -p "$port" -b "/$secret" -W -a -O -I "$page" \
  -t fontSize=12 -t "titleFixed=$(hostname -s)" \
  -t "fontFamily=Menlo, 'DejaVu Sans Mono', TermSymbols, monospace" \
  -t cursorStyle=bar -t cursorBlink=true -t scrollback=100000 -t disableLeaveAlert=true \
  python3 "$dir/termbridge"
