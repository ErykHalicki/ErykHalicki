#!/usr/bin/env python3
"""Run a command (default: login shell) in a pty and act on escape codes sent from any ssh depth.

  OSC 1337 MultipartFile/FilePart/FileEnd, File  ->  save under ~/Downloads/term, open in Brave;
                                                    each FilePart is acked so the sender can pace itself;
                                                    key= keeps one local file per source, open=0 skips Brave;
                                                    id= matching a file here opens it in place, sending nothing
  OSC 52 copy                                    ->  local clipboard
  OSC 52 query (?)                               ->  answered with the local clipboard

ttyd runs this on the machine you sit at, so files and the clipboard land where you are.
"""
import base64
import fcntl
import hashlib
import json
import os
import pty
import pwd
import re
import select
import shutil
import signal
import socket
import struct
import subprocess
import sys
import tempfile
import termios
import time
import tty

DIR = os.path.expanduser("~/Downloads/term")
OURS = (b"1337;MultipartFile=", b"1337;FilePart=", b"1337;FileEnd", b"1337;File=", b"52;")
MAX_PENDING = 64 * 1024 * 1024


def first(*cmds):
    for c in cmds:
        if shutil.which(c[0]):
            return list(c)
    return None


MAC = sys.platform == "darwin"
BROWSER = os.environ.get("TERMBRIDGE_BROWSER", "").split() or (
    ["open", "-a", "Brave Browser"] if MAC else first(["brave"], ["brave-browser"], ["brave-browser-stable"], ["/snap/bin/brave"]))
COPY = ["pbcopy"] if MAC else first(["wl-copy"], ["xsel", "-bi"], ["xclip", "-selection", "clipboard"])
PASTE = ["pbpaste"] if MAC else first(["wl-paste", "-n"], ["xsel", "-bo"], ["xclip", "-o", "-selection", "clipboard"])


def run(cmd, data=None):
    if not cmd:
        return b""
    try:
        return subprocess.run(cmd, input=data, capture_output=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return b""


def launch(path):
    if BROWSER:
        subprocess.Popen(BROWSER + [path], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def params(s):
    out = {}
    for kv in s.split(b";"):
        k, _, v = kv.partition(b"=")
        out[k.decode(errors="replace")] = v
    return out


class Bridge:
    def __init__(self, master):
        self.master = master
        self.tail = b""
        self.pending = None
        self.file = None

    def start_file(self, args):
        try:
            name = base64.b64decode(args.get("name", b"")).decode(errors="replace")
        except ValueError:
            name = ""
        name = os.path.basename(name) or "file"
        base, ext = os.path.splitext(name)
        base = re.sub(r"[^\w.-]", "_", base)[:80] or "file"
        ext = re.sub(r"[^\w]", "", ext)[:16]
        suffix = "." + ext if ext else ""
        os.makedirs(DIR, exist_ok=True)
        key = args.get("key")
        if key:
            # same source, same local file: a resend replaces the copy the browser already has open
            path = os.path.join(DIR, f"{base}-{hashlib.sha1(key).hexdigest()[:8]}{suffix}")
        else:
            fd, path = tempfile.mkstemp(prefix=base + "-", suffix=suffix, dir=DIR)
            os.close(fd)
        fd, tmp = tempfile.mkstemp(prefix=".partial-", dir=DIR)
        self.file = (os.fdopen(fd, "wb"), tmp, path, args.get("open", b"1") != b"0")

    def local_path(self, ident):
        """The sender's file itself if this machine can see it: same path, device and inode."""
        try:
            dev, ino, path = base64.b64decode(ident or b"").decode().split(":", 2)
            st = os.stat(path)
        except (ValueError, OSError):
            return None
        return path if (st.st_dev, st.st_ino) == (int(dev), int(ino)) else None

    def abort_file(self):
        if self.file:
            f, tmp, _, _ = self.file
            f.close()
            os.unlink(tmp)
            self.file = None

    def end_file(self):
        if self.file:
            f, tmp, path, show = self.file
            f.close()
            os.replace(tmp, path)
            self.file = None
            if show:
                launch(path)

    def handle(self, body):
        if body.startswith(b"52;"):
            _, _, data = body[3:].partition(b";")
            if data == b"?":
                reply = base64.b64encode(run(PASTE))
                os.write(self.master, b"\x1b]52;c;" + reply + b"\x1b\\")
            else:
                try:
                    run(COPY, base64.b64decode(data))
                except ValueError:
                    pass
            return
        body = body[5:]
        if body.startswith(b"MultipartFile="):
            self.abort_file()
            args = params(body[14:])
            here = self.local_path(args.get("id"))
            if here:
                os.write(self.master, b"\x1b]1337;FileLocal\x1b\\")
                if args.get("open", b"1") != b"0":
                    launch(here)
                return
            self.start_file(args)
            os.write(self.master, b"\x1b]1337;FileSend\x1b\\")
        elif body.startswith(b"FilePart="):
            if self.file:
                try:
                    self.file[0].write(base64.b64decode(body[9:]))
                except ValueError:
                    pass
            os.write(self.master, b"\x1b]1337;FileAck\x1b\\")
        elif body.startswith(b"FileEnd"):
            self.end_file()
        elif body.startswith(b"File="):
            head, _, data = body[5:].partition(b":")
            self.start_file(params(head))
            try:
                self.file[0].write(base64.b64decode(data))
            except ValueError:
                pass
            self.end_file()

    def feed(self, data):
        """Pass bytes through, pulling out our sequences; scans each byte once since macOS ptys read ~1 KB at a time."""
        buf = self.tail + data
        self.tail = b""
        out = []
        pos = 0
        longest = max(map(len, OURS))
        while pos < len(buf):
            if self.pending is not None:
                ends = [e for e in (buf.find(b"\x07", pos), buf.find(b"\x1b\\", pos)) if e >= 0]
                if not ends:
                    stop = len(buf) - 1 if buf.endswith(b"\x1b") else len(buf)
                    self.pending += buf[pos:stop]
                    self.tail = buf[stop:]
                    if len(self.pending) > MAX_PENDING:
                        self.pending = None
                    break
                end = min(ends)
                self.pending += buf[pos:end]
                body, self.pending = bytes(self.pending), None
                self.handle(body)
                pos = end + (1 if buf[end] == 7 else 2)
                continue
            i = buf.find(b"\x1b]", pos)
            if i < 0:
                stop = len(buf) - 1 if buf.endswith(b"\x1b") else len(buf)
                out.append(buf[pos:stop])
                self.tail = buf[stop:]
                break
            out.append(buf[pos:i])
            head = buf[i + 2:i + 2 + longest]
            if any(head.startswith(p) for p in OURS):
                self.pending = bytearray()
                pos = i + 2
            elif len(head) < longest and any(p.startswith(head) for p in OURS):
                self.tail = buf[i:]
                break
            else:
                out.append(b"\x1b]")
                pos = i + 2
        return b"".join(out)


def write_all(fd, data):
    while data:
        data = data[os.write(fd, data):]


def spawn(argv):
    pid, master = pty.fork()
    if pid == 0:
        try:
            os.execvp(argv[0], argv)
        finally:
            os._exit(127)
    return pid, master


def direct(argv):
    """No tab id: the shell lives exactly as long as this connection."""
    pid, master = spawn(argv)
    interactive = os.isatty(0)

    def resize(*_):
        if interactive:
            fcntl.ioctl(master, termios.TIOCSWINSZ, fcntl.ioctl(0, termios.TIOCGWINSZ, b"\0" * 8))

    resize()
    signal.signal(signal.SIGWINCH, resize)
    saved = termios.tcgetattr(0) if interactive else None
    if interactive:
        tty.setraw(0)
    bridge = Bridge(master)
    fds = [0, master]
    try:
        while True:
            for fd in select.select(fds, [], [])[0]:
                if fd == master:
                    try:
                        data = os.read(master, 65536)
                    except OSError:
                        data = b""
                    if not data:
                        return
                    write_all(1, bridge.feed(data))
                else:
                    data = os.read(0, 65536)
                    if data:
                        write_all(master, data)
                    else:
                        fds.remove(0)
    finally:
        if saved:
            termios.tcsetattr(0, termios.TCSAFLUSH, saved)
        _, status = os.waitpid(pid, 0)
        sys.exit(os.waitstatus_to_exitcode(status))


# Sessions: Brave drops its connections whenever the network changes (closing the lid does it), and
# ttyd then kills the command and starts a new one. With a tab id, the shell instead lives in a
# background server on a unix socket and each connection is just a client that attaches to it; a
# reconnecting tab gets its shell back, with recent output replayed and terminal modes restored.
SESSIONS = os.path.expanduser("~/.cache/term/sessions")
DETACHED_TTL = 7 * 24 * 3600
REPLAY = 512 * 1024
MODES = re.compile(rb"\x1b\[\?([0-9;]+)([hl])")


def frame(kind, payload):
    return kind + len(payload).to_bytes(4, "big") + payload


def serve(sock_path, srv, argv):
    tab = os.path.basename(sock_path)[:-5]
    os.environ["TERMBRIDGE_TAB"] = tab
    pid, master = spawn(argv)
    meta_path = sock_path[:-5] + ".json"
    meta = {"pid": pid, "started": time.time(), "attached": False, "detached": time.time()}

    def save(**changes):
        # read by `term sessions`
        meta.update(changes)
        with open(meta_path + ".tmp", "w") as f:
            json.dump(meta, f)
        os.replace(meta_path + ".tmp", meta_path)

    save()
    bridge = Bridge(master)
    client, inbuf, replay, modes, fresh = None, b"", bytearray(), {}, False
    detached_at, redraw = time.monotonic(), None

    def set_size(ws):
        fcntl.ioctl(master, termios.TIOCSWINSZ, ws)

    try:
        while True:
            now = time.monotonic()
            waits = [t for t in (redraw and redraw[0], None if client else detached_at + DETACHED_TTL) if t]
            timeout = max(0, min(waits) - now) if waits else None
            ready = select.select([srv, master] + ([client] if client else []), [], [], timeout)[0]
            now = time.monotonic()
            if redraw and now >= redraw[0]:
                set_size(redraw[1])
                redraw = None
            if not client and now >= detached_at + DETACHED_TTL:
                os.kill(pid, signal.SIGHUP)
                return
            if srv in ready:
                if client:
                    client.close()
                client, inbuf, fresh = srv.accept()[0], b"", True
                save(attached=True)
                restore = b"".join(b"\x1b[?" + n + v for n, v in modes.items())
                try:
                    client.sendall(bytes(replay) + restore)
                except OSError:
                    client = None
            if master in ready:
                try:
                    data = os.read(master, 65536)
                except OSError:
                    data = b""
                if not data:
                    return
                out = bridge.feed(data)
                replay += out
                if len(replay) > REPLAY:
                    nl = replay.find(b"\n", len(replay) - REPLAY)
                    del replay[:nl + 1 if nl >= 0 else len(replay) - REPLAY]
                for m in MODES.finditer(out):
                    for n in m.group(1).split(b";"):
                        modes[n] = m.group(2)
                if client:
                    try:
                        client.sendall(out)
                    except OSError:
                        client.close()
                        client, detached_at = None, now
                        save(attached=False, detached=time.time())
            if client and client in ready:
                data = client.recv(65536)
                if not data:
                    client.close()
                    client, detached_at = None, now
                    save(attached=False, detached=time.time())
                    continue
                inbuf += data
                while len(inbuf) >= 5 and len(inbuf) >= 5 + int.from_bytes(inbuf[1:5], "big"):
                    n = int.from_bytes(inbuf[1:5], "big")
                    kind, payload, inbuf = inbuf[:1], inbuf[5:5 + n], inbuf[5 + n:]
                    if kind == b"d":
                        write_all(master, payload)
                    elif kind == b"w" and fresh:
                        # a full-screen app only repaints if its size really changes, so step through
                        # one column narrower to make it redraw for the client that just attached
                        rows, cols, x, y = struct.unpack("HHHH", payload)
                        set_size(struct.pack("HHHH", rows, max(1, cols - 1), x, y))
                        redraw, fresh = (time.monotonic() + 0.05, payload), False
                    elif kind == b"w" and redraw:
                        redraw = (redraw[0], payload)
                    elif kind == b"w":
                        set_size(payload)
    finally:
        for p in (sock_path, meta_path):
            try:
                os.unlink(p)
            except OSError:
                pass
        if client:
            client.close()


def attach(sock_path):
    c = socket.socket(socket.AF_UNIX)
    try:
        c.connect(sock_path)
        return c
    except ConnectionRefusedError:
        os.unlink(sock_path)
        return None
    except OSError:
        return None


def start_server(sock_path, argv):
    srv = socket.socket(socket.AF_UNIX)
    try:
        srv.bind(sock_path)
    except OSError:
        return
    os.chmod(sock_path, 0o600)
    srv.listen(4)
    if os.fork():
        srv.close()
        return
    os.setsid()
    if os.fork():
        os._exit(0)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    null = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(null, fd)
    try:
        serve(sock_path, srv, argv)
    finally:
        os._exit(0)


def session(tab, argv):
    os.makedirs(SESSIONS, mode=0o700, exist_ok=True)
    sock_path = os.path.join(SESSIONS, tab + ".sock")
    c = attach(sock_path)
    if not c:
        start_server(sock_path, argv)
        for _ in range(100):
            c = attach(sock_path)
            if c:
                break
            time.sleep(0.02)
    if not c:
        return direct(argv)
    interactive = os.isatty(0)
    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_w, False)
    signal.set_wakeup_fd(wake_w)
    signal.signal(signal.SIGWINCH, lambda *_: None)

    def send_size():
        if interactive:
            c.sendall(frame(b"w", fcntl.ioctl(0, termios.TIOCGWINSZ, b"\0" * 8)))

    send_size()
    saved = termios.tcgetattr(0) if interactive else None
    if interactive:
        tty.setraw(0)
    fds = [0, c, wake_r]
    try:
        while True:
            for fd in select.select(fds, [], [])[0]:
                if fd == wake_r:
                    os.read(wake_r, 512)
                    send_size()
                elif fd == c:
                    data = c.recv(65536)
                    if not data:
                        return
                    write_all(1, data)
                else:
                    data = os.read(0, 65536)
                    if data:
                        c.sendall(frame(b"d", data))
                    else:
                        fds.remove(0)
    finally:
        if saved:
            termios.tcsetattr(0, termios.TCSAFLUSH, saved)


def main():
    args = sys.argv[1:]
    tab = None
    if args and args[0].startswith("--tab="):
        tab = re.sub(r"[^\w-]", "", args.pop(0)[6:])[:32] or None
    argv = args or [os.environ.get("SHELL") or pwd.getpwuid(os.getuid()).pw_shell, "-l"]
    if tab:
        session(tab, argv)
    else:
        direct(argv)


if __name__ == "__main__":
    main()
